# Скопируйте в .env (он в .gitignore) — docker compose подхватит автоматически:
#   cp .env.example .env
#
# Ключ OpenRouter (https://openrouter.ai/keys). Используется:
#   * ml        — OCR-переранжирование near-duplicates (VLM читает этикетку);
#   * sommelier — диалог (LLM) и голосовой ввод (STT).
# Без ключа всё поднимется, но ml работает только в режиме retrieval, а сомелье не отвечает.
SEARCH_MODEL=/app/models/siglip2-base-patch16-256
SEARCH_ENCODER=siglip
OPENROUTER_API_KEY="sk-or-v1<...>"

# --- необязательно ---
# модели сомелье: диалог (LLM) и распознавание речи (STT)
# LLM_MODEL=google/gemini-2.5-flash
# STT_MODEL=google/gemini-2.5-flash
# 1 — показывать в UI время поиска, сходство и score/margin (для демо)
# DEBUG_INFO=1
# адрес сайта для HTTPS (нужен для голосового ввода): IP сервера или домен (1-2-3-4.sslip.io)
# PUBLIC_HOST=155.138.200.98
