# cp .env.example .env   (.env в .gitignore; применить правку — docker compose up -d)
#
# Ключ OpenRouter (https://openrouter.ai/keys): OCR-rerank в ml, диалог и голос в sommelier.
# Без ключа ml работает только retrieval'ом, чат сомелье не отвечает.
OPENROUTER_API_KEY="sk-or-v1<...>"

# --- необязательно ---
# модели сомелье: диалог (LLM) и распознавание речи (STT)
# LLM_MODEL=google/gemini-2.5-flash
# STT_MODEL=google/gemini-2.5-flash
# 1 — показывать в UI время поиска, score/margin
# DEBUG_INFO=1
# адрес сайта для HTTPS (нужен для микрофона): IP сервера или домен (1-2-3-4.sslip.io)
# PUBLIC_HOST=155.138.200.98
# HTTP_PORT=80
# HTTPS_PORT=443
#
# Параметры распознавания (модели, кроп, пороги, OCR) — только в config/pipeline.yaml.
