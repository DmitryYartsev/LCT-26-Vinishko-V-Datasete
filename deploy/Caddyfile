# HTTPS-прокси перед web: браузер даёт доступ к микрофону (голосовой ввод сомелье)
# только в secure context — по HTTPS или на localhost. По голому http://<ip>:3000 его нет.
#
# PUBLIC_HOST (в .env) — адрес, по которому открывают сайт:
#   * IP (192.168.1.50) или localhost — сертификат выпускает внутренний CA Caddy,
#     браузер один раз предупредит («Дополнительно → Перейти на сайт»);
#   * домен, смотрящий на сервер (в т.ч. 1-2-3-4.sslip.io для IP 1.2.3.4), — настоящий
#     сертификат Let's Encrypt, без предупреждений; нужны открытые 80 и 443 порты.
{
	# клиенты не шлют SNI при заходе по IP — без этого Caddy не поймёт, какой сертификат отдать
	default_sni {$PUBLIC_HOST:localhost}
}

{$PUBLIC_HOST:localhost} {
	encode gzip
	reverse_proxy web:3000
}
